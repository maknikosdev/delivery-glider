{
  "expo": {
    "name": "The Delivery Glider",
    "slug": "the-delivery-glider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05030d",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05030d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.neoncourier.deliveryglider",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05030d"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#05030d"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6323bd3f-7eea-450a-8f1b-163f73df7186"
      }
    }
  }
}
